# Optional HTTPS override for the Windows executable; defaults to the latest ezPen release.
VITE_EZPEN_DOWNLOAD_URL=
# Optional HTTPS checksum override. When overriding the executable, set this to its
# matching checksum file; otherwise the default checksum link is hidden.
VITE_EZPEN_CHECKSUM_URL=
# Optional public release notes page. Do not use a private repository URL.
VITE_EZPEN_RELEASES_URL=
# Optional canonical site origin, e.g. https://ezpen.example
VITE_SITE_URL=
